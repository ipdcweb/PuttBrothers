{
  "name": "puttbrothers-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --dir website run dev:vinext",
    "build": "pnpm --dir website run build:dev",
    "build:dev": "pnpm --dir website run build:dev",
    "build:production": "pnpm --dir website run build:production",
    "test": "pnpm --dir website test",
    "lint": "pnpm --dir website run lint",
    "deploy:dev": "pnpm --dir website run deploy:dev",
    "deploy:preview": "pnpm run deploy:dev",
    "deploy:production": "pnpm --dir website run deploy:production",
    "app:dev": "npm --prefix app run dev",
    "app:start": "npm --prefix app start",
    "app:build": "npm --prefix app run build",
    "app:check": "npm --prefix app run check",
    "app:test": "npm --prefix app test"
  }
}
