{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puttbrothers-com",
  "account_id": "5929fdac0cd2d82d7378551cf4c20774",
  "vars": { "PREVIEW_MODE": "false" },
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "routes": [
    {
      "pattern": "puttbrothers.com/*",
      "zone_name": "puttbrothers.com"
    },
    {
      "pattern": "www.puttbrothers.com/*",
      "zone_name": "puttbrothers.com"
    },
    {
      "pattern": "puttbrothers.ch/*",
      "zone_name": "puttbrothers.ch"
    },
    {
      "pattern": "www.puttbrothers.ch/*",
      "zone_name": "puttbrothers.ch"
    },
    {
      "pattern": "puttbrothers.de/*",
      "zone_name": "puttbrothers.de"
    },
    {
      "pattern": "www.puttbrothers.de/*",
      "zone_name": "puttbrothers.de"
    },
    {
      "pattern": "puttbrothers.uk/*",
      "zone_name": "puttbrothers.uk"
    },
    {
      "pattern": "www.puttbrothers.uk/*",
      "zone_name": "puttbrothers.uk"
    }
  ],
  "r2_buckets": [
    { "binding": "PRODUCT_MEDIA", "bucket_name": "puttbrothers-product-media-production" },
    { "binding": "LAYOUT_PDFS", "bucket_name": "puttbrothers-layout-pdfs-production" }
  ],
  "ratelimits": [{ "name": "PDF_UPLOAD_RATE_LIMITER", "namespace_id": "2026102302", "simple": { "limit": 5, "period": 60 } }],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    // Workers Cache ignores the hostname. This Worker also redirects aliases,
    // so only use the URL-keyed Cache API in worker.ts and static asset caching.
    "enabled": false
  }
}
