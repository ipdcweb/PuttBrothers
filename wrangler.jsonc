{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puttbrothers-com",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "routes": [
    {
      "pattern": "puttbrothers.com/*",
      "zone_name": "puttbrothers.com"
    },
    {
      "pattern": "www.puttbrothers.com/*",
      "zone_name": "puttbrothers.com"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  }
}
